" Basic settings
set number
set relativenumber

set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab
set autoindent
set smartindent

set colorcolumn=70
highlight ColorColumn ctermbg=lightgrey guibg=lightgrey

set scrolloff=8

" Java settings
let java_highlight_all = 1
let java_highlight_debug = 1
let java_ignore_javadoc = 0
let java_mark_braces_in_parens_as_errors = 1
